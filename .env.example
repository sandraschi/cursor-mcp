# User API key — cloud agents /v1/* (Dashboard → Integrations)
CURSOR_API_KEY=

# Team Admin API key — /teams/spend, usage events (Dashboard → Settings → Admin API Keys)
# Optional but required for full spend visibility on Teams/Enterprise
CURSOR_ADMIN_API_KEY=

# Alert thresholds (cents)
CURSOR_HOURLY_SPEND_WARN_CENTS=300
CURSOR_ON_DEMAND_WARN_CENTS=2000
CURSOR_RUNNING_AGENTS_WARN=3

# Filter spend row to your email on multi-member teams
# CURSOR_USAGE_EMAIL=you@example.com

# HTTP mode (Fritz)
CURSOR_MCP_HOST=127.0.0.1
CURSOR_MCP_PORT=11000

# Local cache (usage deltas between polls)
# CURSOR_MCP_CACHE_DIR=%USERPROFILE%\.cursor-mcp

# Inter-agent inbox drop (cursor_inbox) — polled at Cursor chat start
# CURSOR_INBOX_DIR=%USERPROFILE%\.cursor-mcp\inbox
